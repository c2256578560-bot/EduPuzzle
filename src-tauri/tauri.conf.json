{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EduPuzzle",
  "version": "4.0.0",
  "identifier": "edu.qust.edupuzzle",
  "build": {
    "beforeBuildCommand": "node scripts/build-web.mjs --tauri",
    "beforeDevCommand": "node scripts/build-web.mjs --tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EduPuzzle 青科大学生全能学习工作台",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "EduPuzzle",
    "shortDescription": "青科大学生全能学习工作台",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
